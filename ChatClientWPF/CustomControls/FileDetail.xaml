<UserControl x:Class="ChatClientWPF.CustomControls.FileDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChatClientWPF.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="300"
             Background="White"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             >
    <UserControl.Resources>
        <PathGeometry x:Key="DocIcon2" Figures="m 25.7 9.3 l -7 -7 c -0.2 -0.2 -0.4 -0.3 -0.7 -0.3 H 8 c -1.1 0 -2 0.9 -2 2 v 24 c 0 1.1 0.9 2 2 2 h 16 c 1.1 0 2 -0.9 2 -2 V 10 c 0 -0.3 -0.1 -0.5 -0.3 -0.7 M 18 4.4 l 5.6 5.6 H 18 z M 24 28 H 8 V 4 h 8 v 6 c 0 1.1 0.9 2 2 2 h 6 z M 10 22 h 12 v 2 H 10 z m 0 -6 h 12 v 2 H 10 z" FillRule="Nonzero"/>
        <PathGeometry x:Key="CloseIcon" Figures="M 17.414 16 L 26 7.414 L 24.586 6 L 16 14.586 L 7.414 6 L 6 7.414 L 14.586 16 L 6 24.586 L 7.414 26 L 16 17.414 L 24.586 26 L 26 24.586 z" FillRule="Nonzero"/>

        <PathGeometry x:Key="DocIcon" Figures="m 25.7 9.3 l -7 -7 A 0.908 0.908 0 0 0 18 2 H 8 a 2.006 2.006 0 0 0 -2 2 v 24 a 2.006 2.006 0 0 0 2 2 h 16 a 2.006 2.006 0 0 0 2 -2 V 10 a 0.908 0.908 0 0 0 -0.3 -0.7 M 18 4.4 l 5.6 5.6 H 18 Z M 24 28 H 8 V 4 h 8 v 6 a 2.006 2.006 0 0 0 2 2 h 6 Z" FillRule="Nonzero"/>
    </UserControl.Resources>
    
    <Grid Margin="0,15">
        <Grid.ColumnDefinitions>
            <!--For icon-->
            <ColumnDefinition Width="60"/>
            <!--Details-->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--Doc Icon-->
        <Path 
            Data="{StaticResource DocIcon2}"
            Fill="Silver"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Width="25"
            Stretch="Uniform"
            />
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!--File name & Size-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <!--File name-->
                <TextBlock 
                    TextTrimming="CharacterEllipsis"
                    MaxHeight="100"
                    FontWeight="Bold"
                    Text="{Binding FileName,
                    FallbackValue=FileName, TargetNullValue=FileName}"
    
                />
                <!--File size-->
                <TextBlock 
                    Grid.Column="1" Grid.Row="0"
                    Padding="5,0"
                    Text="{Binding FileSize , 
                    FallbackValue=FileSizeInMb, TargetNullValue=FileSizeInMb}"
                />
            </Grid>
            <!--Cancel button-->
            <Button
                BorderThickness="0"
                Background="Transparent"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
            >
                <Path Data="{StaticResource CloseIcon}"
                      Fill="Gray"
                      Height="10"
                      Stretch="Uniform"></Path>
            </Button>
            <ProgressBar
                Name="pb"
                Grid.Row="1"
                Height="8"
                Foreground="#47BDFF"
                />
                
            <TextBlock Grid.Row="2">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" Value="{Binding Value, 
                            ElementName=pb, StringFormat={}{0:#,#.0}% done}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Value, ElementName=pb}" 
                                         Value="100">
                                <Setter Property="Text" Value="Upload complete"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="2"
                       HorizontalAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Text" 
                                
                                Value="{Binding  UploadSpeed, ElementName=pb, StringFormat={}{0} Kb/sec}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Value, 
                            ElementName=pb}" 
                                         Value="100">
                                <Setter Property="Text" Value=""></Setter>
                                <Setter Property="Visibility" Value="Collapsed"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </Grid>


    </Grid>
</UserControl>
