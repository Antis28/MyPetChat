<Application x:Class="ChatClientWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChatClientWPF"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="Corner10" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="10"></Setter>
        </Style>

        <Style x:Key="LoadButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF80CD24"></Setter>
            <Setter Property="BorderThickness" Value="0"></Setter>
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="FontSize" Value="12"></Setter>
            <Setter Property="Width" Value="100"></Setter>
            <Setter Property="Height" Value="20"></Setter>
           
        </Style>
    </Application.Resources>
</Application>
